"""
tag_shots.py — attach a location bucket + on-court 10 to every shot (O3 input)
==============================================================================
Tags every field-goal attempt from the Points feed with a shot-location bucket
(play_context.classify) and joins to PBP on (Season, Gamecode,
NUM_ANOT == NUMBEROFPLAY) to attach the offensive and defensive fives.

FULL RANGE BY DEFAULT:
    python scripts/tag_shots.py

WHAT CHANGED IN WEEK 6 AND WHY
------------------------------
1. SITUATION FLAGS ARE IGNORED (--ignore-situation, on by default).
   The Points feed populates FASTBREAK / SECOND_CHANCE on MADE shots only —
   verified on 2023: transition was 1,954 rows with ZERO misses, second_chance
   2,741 with one. Conditioning on the shot being made removes the outcome
   variance an efficiency model exists to explain, so those buckets cannot
   support a rating. Worse, because classify() gives them precedence over
   location, their presence strips made fastbreak/putback attempts out of the
   location buckets: at_rim FG% read 0.546 with the flags active and 0.648
   without, against a league norm of ~0.62-0.66.

   Passing False for both flags routes every shot down classify()'s location
   branch, which is the Week 2 manually-validated logic, unmodified.

2. THE PRE-2015 CRASH IS FIXED.
   bool(int(FASTBREAK)) raises on null (TypeError) and on "" (ValueError), and
   those flags are unpopulated for every season before 2015. That is why this
   script had only ever been run on 2023 — not a scoping decision, a crash.
   Flags are now parsed defensively even though the default path ignores them.

3. SHOOTER-NOT-IN-EITHER-LINEUP IS DETECTED, NOT ASSUMED.
   The old split_off() fell through to "offence = Lineup_B" whenever the shooter
   was not found in Lineup_A — including when he was in neither. Week 1 measured
   that case at ~0.12% of actions (mis-attribution across a substitution beat).
   Those rows were being INVERTED, not dropped, which pollutes both the offensive
   and the defensive block. They are now identified and excluded, with the rate
   reported per season so it can go in Ch9.

DIAGNOSTICS (read these):
  • join-match-rate — % of shots that found their PBP row, PER SEASON. A single
    bad season is invisible in a pooled number.
  • orientation failures — shooter in neither five; excluded.
  • bucket distribution + FG% — sanity against basketball priors. Expect
    at_rim ~0.65, above_break ~0.35, corner ~0.44, mid_range ~0.40.
  • coord coverage — drives the corner/above-break split; low → those collapse.
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

import polars as pl

from play_context import classify, THREE_ACTIONS, FG_ATTEMPTS

# ID_ACTION code → made-points (for the design matrix); misses = 0
MADE = {"2FGM": 2, "3FGM": 3, "LAYUPMD": 2, "DUNK": 2}

ABSENT = {"", "-", "None", "none", "null", "NULL", "nan", "NaN", "False", "false"}


def parse_flag(v) -> bool:
    """
    Defensive flag coercion. The feed carries these as strings, absent entirely
    before 2015, and int() on null or "" raises. Absence means UNKNOWN, which is
    represented as False here — safe only because the default path ignores these
    flags altogether. If you ever re-enable them, absence must NOT be folded into
    False: 'unknown' and 'not a fastbreak' are different claims.
    """
    if v is None:
        return False
    s = str(v).strip()
    if s in ABSENT:
        return False
    try:
        return bool(int(float(s)))
    except (TypeError, ValueError):
        return s.lower() in {"true", "y", "yes"}


def tag(shots: pl.DataFrame, pbp: pl.DataFrame,
        ignore_situation: bool = True) -> tuple[pl.DataFrame, dict]:
    n_all = shots.height
    shots = shots.filter(pl.col("ID_ACTION").is_in(list(FG_ATTEMPTS)))
    n_fga = shots.height
    if not n_fga:
        raise SystemExit("no field-goal attempts after the ID_ACTION filter — "
                         "check FG_ATTEMPTS against the feed's action codes.")

    def bucket_of(r) -> str:
        fb = False if ignore_situation else parse_flag(r["FASTBREAK"])
        sc = False if ignore_situation else parse_flag(r["SECOND_CHANCE"])
        return classify(r["ID_ACTION"], fb, sc, r["COORD_X"], r["COORD_Y"])

    shots = shots.with_columns(
        pl.struct(["ID_ACTION", "FASTBREAK", "SECOND_CHANCE", "COORD_X", "COORD_Y"])
          .map_elements(bucket_of, return_dtype=pl.Utf8).alias("bucket"),
        pl.col("ID_ACTION").replace_strict(MADE, default=0,
                                           return_dtype=pl.Int32).alias("points"),
    )

    pbp_keyed = pbp.select(["Season", "Gamecode", "NUMBEROFPLAY", "PLAYER",
                            "Lineup_A", "Lineup_B"]).rename({"PLAYER": "pbp_player"})
    j = shots.join(
        pbp_keyed,
        left_on=["Season", "Gamecode", "NUM_ANOT"],
        right_on=["Season", "Gamecode", "NUMBEROFPLAY"],
        how="left",
    )
    matched = j.filter(pl.col("Lineup_A").is_not_null()
                       & pl.col("Lineup_B").is_not_null())

    # ---- orientation: which five is the offence?
    # The shooter must appear in exactly one of them. If he appears in neither,
    # the row's offence/defence cannot be determined and assuming one INVERTS it.
    matched = matched.with_columns([
        pl.col("Lineup_A").list.contains(pl.col("PLAYER")).alias("_in_a"),
        pl.col("Lineup_B").list.contains(pl.col("PLAYER")).alias("_in_b"),
    ])
    n_matched = matched.height
    bad_orient = matched.filter(~(pl.col("_in_a") ^ pl.col("_in_b")))
    n_bad = bad_orient.height
    oriented = matched.filter(pl.col("_in_a") ^ pl.col("_in_b"))

    out = oriented.with_columns([
        pl.when(pl.col("_in_a")).then(pl.col("Lineup_A"))
          .otherwise(pl.col("Lineup_B")).alias("off_players"),
        pl.when(pl.col("_in_a")).then(pl.col("Lineup_B"))
          .otherwise(pl.col("Lineup_A")).alias("def_players"),
    ]).select([
        "Season", "Gamecode", "NUM_ANOT", "TEAM", "PLAYER", "ID_ACTION",
        "bucket", "points", "FASTBREAK", "SECOND_CHANCE", "COORD_X", "COORD_Y",
        "off_players", "def_players",
    ])

    per_season = (
        j.with_columns(pl.col("Lineup_A").is_not_null().alias("_m"))
         .group_by("Season").agg([
             pl.len().alias("shots"),
             pl.col("_m").mean().alias("match_rate"),
             (pl.col("COORD_X").is_not_null()
              & pl.col("COORD_Y").is_not_null()).mean().alias("coord_rate"),
         ]).sort("Season")
    )

    diag = {
        "rows_all": n_all, "rows_fga": n_fga,
        "matched": n_matched, "bad_orientation": n_bad,
        "kept": out.height,
        "match_rate": n_matched / n_fga,
        "per_season": per_season,
        "bad_by_season": (bad_orient.group_by("Season").agg(pl.len().alias("n"))
                          .sort("Season") if n_bad else None),
        "buckets": (out.group_by("bucket").agg([
            pl.len().alias("attempts"),
            (pl.col("points") > 0).sum().alias("made"),
            pl.col("points").sum().alias("pts"),
        ]).with_columns([
            (pl.col("made") / pl.col("attempts")).round(4).alias("fg_pct"),
            (100 * pl.col("pts") / pl.col("attempts")).round(2).alias("pts_per_100"),
        ]).sort("attempts", descending=True)),
        "threes_with_coords": (
            shots.filter(pl.col("ID_ACTION").is_in(list(THREE_ACTIONS)))
                 .select((pl.col("COORD_X").is_not_null()
                          & pl.col("COORD_Y").is_not_null()).mean()).item()
        ),
    }
    return out, diag


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--shots", default="data/shots/**/*.parquet")
    ap.add_argument("--pbp", default="warehouse/pbp_poss.parquet")
    ap.add_argument("--out", default="warehouse/tagged_shots.parquet")
    ap.add_argument("--use-situation-flags", action="store_true",
                    help="restore the pre-Week-6 behaviour of letting FASTBREAK / "
                         "SECOND_CHANCE take precedence over location. Produces a "
                         "biased taxonomy — see the module docstring. Diagnostic use only.")
    ap.add_argument("--min-match-rate", type=float, default=0.98,
                    help="exit non-zero if any season's PBP join falls below this")
    a = ap.parse_args()

    ignore = not a.use_situation_flags
    print(f"situation flags: {'IGNORED (four location buckets)' if ignore else 'ACTIVE (biased)'}")

    shots = pl.read_parquet(a.shots)
    pbp = pl.read_parquet(a.pbp)
    print(f"read {shots.height:,} Points-feed rows, {pbp.height:,} PBP rows")

    out, d = tag(shots, pbp, ignore_situation=ignore)
    Path(a.out).parent.mkdir(parents=True, exist_ok=True)
    out.write_parquet(a.out)

    print(f"\n{d['rows_all']:,} feed rows → {d['rows_fga']:,} field-goal attempts "
          f"(dropped {d['rows_all']-d['rows_fga']:,} free throws / non-shots)")
    print(f"PBP join: {d['matched']:,}/{d['rows_fga']:,} = {d['match_rate']*100:.2f}%")
    if d["bad_orientation"]:
        pct = 100 * d["bad_orientation"] / max(d["matched"], 1)
        print(f"orientation failures: {d['bad_orientation']:,} ({pct:.3f}%) — shooter "
              f"in neither five, offence/defence undeterminable. EXCLUDED.")
        print("  (Week 1 measured ~0.12% mis-attribution near substitutions; a number "
              "in that range is expected. Report it in Ch9.)")
        print(d["bad_by_season"])
    print(f"kept: {d['kept']:,} rows → {a.out}")
    print(f"threes with coordinates: {d['threes_with_coords']*100:.1f}%")

    print("\nper-season join + coordinate coverage:")
    with pl.Config(tbl_rows=25):
        print(d["per_season"])

    print("\nbucket distribution:")
    print(d["buckets"])
    print("  expected: at_rim ~0.65, above_break ~0.35, corner ~0.44, mid ~0.40")
    print("  pts/100:  corner ~= at_rim > above_break > mid_range")

    seasons = sorted(d["per_season"]["Season"].to_list())
    print(f"\nseasons tagged: {len(seasons)}  {seasons[0]}-{seasons[-1]}")
    missing = [s for s in range(2007, 2026) if s not in seasons]
    if missing:
        print(f"  !! MISSING seasons: {missing}")

    bad = d["per_season"].filter(pl.col("match_rate") < a.min_match_rate)
    if bad.height:
        print(f"\n!! {bad.height} season(s) below the {a.min_match_rate:.0%} join floor:")
        print(bad)
        print("   The NUM_ANOT <-> NUMBEROFPLAY key may not hold in those seasons.")
        print("   Do NOT build a design on this output until resolved.")
        sys.exit(4)
    print("\nall seasons clear the join floor.")


if __name__ == "__main__":
    main()